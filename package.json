{
  "name": "cadense-orders",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node test/core.test.mjs && node test/production.test.mjs && node test/order-sort.test.mjs && node test/team.test.mjs && node test/watchlist.test.mjs && node test/inventory.test.mjs",
    "test:http": "node test/http.test.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "vite": "^6.3.0",
    "typescript": "^5.8.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  }
}
