NODE_ENV=production
PORT=3000
SHOPIFY_STORE_DOMAIN=cadenseadaptive.myshopify.com
SHOPIFY_API_VERSION=2026-10
# Same-organization Dev Dashboard app (preferred)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Optional legacy installed-app token instead of client credentials
SHOPIFY_ACCESS_TOKEN=
SESSION_SECRET=
USERS_FILE=/data/users.json
DATABASE_PATH=/data/cadense.sqlite
DEMO_MODE=false
OVERDUE_DAYS=7
ELEVATED_DAYS=11
HIGH_PRIORITY_DAYS=15
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
AUTHORIZED_USERS_JSON=
